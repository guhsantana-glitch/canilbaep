# Copie este arquivo para .env e ajuste os valores.

DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Fotos/documentos na nuvem (Cloudflare R2, opcional no local) ---
# Sem isso, usa a pasta media/ local. Na nuvem (Render), preencha para
# os arquivos sobreviverem aos deploys.
# R2_BUCKET=canilbaep-media
# R2_ENDPOINT_URL=https://xxxx.r2.cloudflarestorage.com
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_PUBLIC_URL=pub-xxxx.r2.dev
