# Copie este arquivo para .env (ou configure como variáveis de ambiente reais)
# e preencha com as credenciais que você não vai commitar no Git.

DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Login com gov.br (Login Único) ---
# Deixe as 3 variáveis abaixo em branco para usar só o login local por enquanto.
# Depois de solicitar a credencial em https://acesso.gov.br/roteiro-tecnico/solicitacaocredencialprocesso.html
# preencha com os dados fornecidos.
GOVBR_ENV=staging
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_REDIRECT_URI=http://localhost:8000/accounts/govbr/callback/
