# Copie este arquivo para .env e ajuste os valores.

DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Fotos/documentos na nuvem (storage S3, opcional no local) ---
# Sem isso, usa a pasta media/ local. Na nuvem (Render), preencha para
# os arquivos sobreviverem aos deploys. Vale para Cloudflare R2 ou
# Supabase Storage (ambos S3-compatíveis).
# STORAGE_BUCKET=canilbaep-media
# STORAGE_ENDPOINT_URL=https://xxxx.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_PUBLIC_URL=pub-xxxx.r2.dev
# STORAGE_REGION=auto
